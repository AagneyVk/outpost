{
  "manifest_version": 3,
  "name": "OUTPOST loopback bridge experiment",
  "version": "0.0.1",
  "permissions": ["webRequest", "declarativeNetRequest"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://example.com/*",
    "https://expired.badssl.com/*",
    "https://self-signed.badssl.com/*"
  ],
  "externally_connectable": { "matches": ["http://127.0.0.1/*"] },
  "background": { "service_worker": "worker.js" }
}
