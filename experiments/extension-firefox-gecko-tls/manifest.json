{
  "manifest_version": 2,
  "name": "OUTPOST Firefox HTTPS bridge research fixture",
  "version": "0.0.1",
  "applications": { "gecko": { "id": "outpost-https-fixture@example.invalid" } },
  "permissions": ["webRequest", "webRequestBlocking", "https://example.com/*",
    "https://expired.badssl.com/*", "https://self-signed.badssl.com/*", "https://example.org/*", "http://127.0.0.1/*"],
  "background": { "scripts": ["config.js", "background.js"] },
  "content_scripts": [{ "matches": ["http://127.0.0.1/*"], "js": ["content.js"], "run_at": "document_start" }]
}
